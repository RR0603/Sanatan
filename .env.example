# Copy to .env and `source .env` for local runs.
# In GitHub, the two below go in Settings > Secrets; the rest go in Variables.

# --- required ---
export TELEGRAM_BOT_TOKEN="8123456789:AAH..."   # from @BotFather
export TELEGRAM_CHAT_ID="987654321"             # from scripts/get_chat_id.py

# --- who and where ---
export BRIEFING_NAME="Rahul"
export BRIEFING_PLACE="Delhi"
export BRIEFING_LAT="28.6139"
export BRIEFING_LON="77.2090"
export BRIEFING_TZ="Asia/Kolkata"
export BRIEFING_UNITS="metric"                  # metric | imperial

# --- content ---
export BRIEFING_SECTIONS="weather,news,onthisday,quote"
export NEWS_FEEDS="https://news.google.com/rss?hl=en-IN&gl=IN&ceid=IN:en"
export NEWS_LIMIT="5"

# --- optional AI intro (leave LLM_API_KEY empty to disable) ---
export LLM_API_KEY=""
export LLM_PROVIDER="openai"                    # openai | anthropic
export LLM_BASE_URL="https://api.groq.com/openai/v1"
export LLM_MODEL="llama-3.3-70b-versatile"
